// # oocp Main Entry Point
//
// Logline: Zero-copy clone-capable file and directory copier using io_uring, copy_file_range, and pure openOODA.
//
// Setup: Demands &FsReadCap, &FsWriteCap, &ProcessCap, and &EnvCap tokens for bounded copy operations.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Dispatch synthetic demo execution when --demo is specified.
//   3. Execute capability-bounded file and directory copy engine.
//   4. Format and stream results as POSIX verbose output, theme summaries, or JSON.

import "core/cp_types.oo";
import "core/cp_engine.oo";
import "core/cp_demo.oo";
import "render/cp_theme.oo";
import "render/cp_view.oo";
import "render/cp_json.oo";
import "ipc/cp_opts.oo";
import "ipc/mcp_serve.oo";
import "anchor.oo";

fn render_help() -> String {
    return "oocp 0.2.0 (openOODA sovereign files & navigation)\n"
        + "usage: oocp [options] SOURCE... DEST\n"
        + "   or: oocp [options] -t DIRECTORY SOURCE...\n\n"
        + "Zero-copy clone-capable file and directory copier using io_uring and copy_file_range.\n\n"
        + "Options:\n"
        + "  -r, -R, --recursive      copy directories recursively\n"
        + "  -a, --archive            same as -dR --preserve=all\n"
        + "  -p, --preserve           preserve file attributes where supported\n"
        + "  -u, --update             copy only when source is newer or target is missing\n"
        + "  -f, --force              force overwrite of existing destination files\n"
        + "  -n, --no-clobber         do not overwrite an existing file\n"
        + "  -v, --verbose            explain what is being done\n"
        + "  -s, --symbolic-link      make symbolic links instead of copying\n"
        + "  -l, --link               hard link files instead of copying\n"
        + "      --reflink[=WHEN]     control clone/CoW copies (always, auto, never) [default: auto]\n"
        + "  -b, --backup             make a backup of each existing destination file\n"
        + "  -S, --suffix <SUFFIX>    override backup suffix [default: ~]\n"
        + "  -t, --target-directory <DIR> copy all SOURCE arguments into DIRECTORY\n"
        + "  -T, --no-target-directory treat DEST as a normal file\n"
        + "      --demo               run synthetic zero-copy replication telemetry demo\n"
        + "      --json               output formatted as JSON Lines\n"
        + "      --theme <NAME>       terminal color theme: default, ember, ocean, matrix, cyber, monochrome\n"
        + "  -h, --help               display this help and exit\n"
        + "  -v, --version            output version information and exit\n"
        + "      --mcp                run as Model Context Protocol stdio server\n";
}

fn render_version() -> String {
    return "oocp 0.2.0 (openOODA sovereign files & navigation)\n";
}

fn main(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    pr: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Int {
    let parsed: ParsedCli = parse_cli_args(args);

    if parsed.show_help {
        print(render_help());
        return 0;
    }

    if parsed.show_version {
        print(render_version());
        return 0;
    }

    if parsed.run_mcp {
        run_mcp_server(fr, fw);
        return 0;
    }

    let th: ThemePalette = get_theme(parsed.config.theme);

    if parsed.config.demo_mode {
        let demo_sum: CpSummary = build_demo_summary();
        if parsed.config.json_output {
            print(summary_to_json(demo_sum) + "\n");
        } else {
            let n_recs: Int = list_len(demo_sum.records);
            let mut ri: Int = 0;
            while ri < n_recs {
                let rec: CpFileRecord = list_get(demo_sum.records, ri);
                print(render_verbose_record(rec, th));
                ri = ri + 1;
            }
            print(render_summary_table(demo_sum, th));
        }
        return 0;
    }

    let n_sources: Int = list_len(parsed.config.sources);
    if n_sources == 0 {
        print("oocp: missing file operand\nTry 'oocp --help' for more information.\n");
        return 1;
    }

    if chars_len(parsed.config.target_dir) == 0 && chars_len(parsed.config.dest) == 0 {
        print("oocp: missing destination file operand after '" + list_get(parsed.config.sources, 0) + "'\n");
        return 1;
    }

    let summary: CpSummary = execute_cp(fr, fw, parsed.config);

    if parsed.config.json_output {
        print(summary_to_json(summary) + "\n");
    } else {
        if parsed.config.verbose {
            let n_recs: Int = list_len(summary.records);
            let mut ri: Int = 0;
            while ri < n_recs {
                let rec: CpFileRecord = list_get(summary.records, ri);
                print(render_verbose_record(rec, th));
                ri = ri + 1;
            }
        } else if summary.failed > 0 {
            let n_recs: Int = list_len(summary.records);
            let mut ri: Int = 0;
            while ri < n_recs {
                let rec: CpFileRecord = list_get(summary.records, ri);
                if rec.status == "failed" {
                    print("oocp: " + rec.error + "\n");
                }
                ri = ri + 1;
            }
        }
    }

    if summary.failed > 0 {
        return 1;
    }
    return 0;
}
