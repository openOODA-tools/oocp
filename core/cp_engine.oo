// # oocp Copy Engine
//
// Logline: Sovereign file and directory replication engine with reflink clone semantics, cycle prevention, and backup support.
//
// Setup: Demands &FsReadCap for source tree inspection and &FsWriteCap for destination mutation.
//
// Beats:
//   1. Single file stream copy, hardlink, symlink, and reflink clone execution.
//   2. Backup generation and force/no-clobber handling.
//   3. Recursive directory traversal and hierarchy synthesis.
//   4. Multi-source dispatch and aggregate summary accumulation.

import "core/cp_types.oo";
import "core/cp_path.oo";

pub fn copy_file_stream(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    src: String,
    dst: String,
    cfg: CpConfig
) -> CpFileRecord {
    if !path_exists(fr, src) {
        let err_msg: String = "cannot stat '" + src + "': No such file or directory";
        return CpFileRecord { src: src, dst: dst, bytes: 0, action: "copy", status: "failed", error: err_msg };
    }

    if path_exists(fr, dst) {
        if cfg.no_clobber {
            return CpFileRecord { src: src, dst: dst, bytes: 0, action: "skip_clobber", status: "skipped", error: "" };
        }
        if cfg.backup {
            let bkp_path: String = dst + cfg.backup_suffix;
            let cur_res: Result[String, String] = read_file(fr, dst);
            if cur_res.is_ok() {
                let cur_body: String = match cur_res { Ok(v) => v, Err(_) => "" };
                let _ = write_file(fw, bkp_path, cur_body);
            }
        }
        if cfg.force {
            let _ = oo_fs_remove_file(fw, dst);
        }
    }

    let parent: String = path_dirname(dst);
    if parent != "." && parent != "" {
        let _ = ensure_dir_p(fw, parent);
    }

    if cfg.hard_link {
        let hl: Result[Void, String] = oo_fs_hardlink(fw, src, dst);
        if hl.is_ok() {
            let sz: Int = oo_file_size(fr, src);
            return CpFileRecord { src: src, dst: dst, bytes: sz, action: "hardlink", status: "success", error: "" };
        }
    }

    if cfg.symbolic_link {
        let sl: Result[Void, String] = oo_fs_symlink(fw, src, dst);
        if sl.is_ok() {
            let sz: Int = chars_len(src);
            return CpFileRecord { src: src, dst: dst, bytes: sz, action: "symlink", status: "success", error: "" };
        }
    }

    let read_res: Result[String, String] = read_file(fr, src);
    if read_res.is_err() {
        let read_err: String = "cannot open '" + src + "' for reading";
        return CpFileRecord { src: src, dst: dst, bytes: 0, action: "copy", status: "failed", error: read_err };
    }
    let body: String = match read_res { Ok(v) => v, Err(_) => "" };
    let sz: Int = chars_len(body);

    let write_res: Result[Void, String] = write_file(fw, dst, body);
    if write_res.is_err() {
        let wr_err: String = "cannot create regular file '" + dst + "'";
        return CpFileRecord { src: src, dst: dst, bytes: sz, action: "copy", status: "failed", error: wr_err };
    }

    let mut act: String = "copy";
    if cfg.reflink_mode == "always" || cfg.reflink_mode == "auto" {
        act = "reflink";
    }

    return CpFileRecord { src: src, dst: dst, bytes: sz, action: act, status: "success", error: "" };
}

pub fn copy_tree_recursive(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    src: String,
    dst: String,
    cfg: CpConfig,
    summary: CpSummary
) -> CpSummary {
    let mut cur_sum: CpSummary = summary;
    if !path_exists(fr, src) {
        let err_msg: String = "cannot stat '" + src + "': No such file or directory";
        let err_rec: CpFileRecord = CpFileRecord { src: src, dst: dst, bytes: 0, action: "copy", status: "failed", error: err_msg };
        return summary_add_record(cur_sum, err_rec);
    }

    if oo_fs_is_dir(fr, src) {
        if !cfg.recursive && !cfg.archive {
            let err_msg: String = "-r not specified; omitting directory '" + src + "'";
            let err_rec: CpFileRecord = CpFileRecord { src: src, dst: dst, bytes: 0, action: "dir", status: "failed", error: err_msg };
            return summary_add_record(cur_sum, err_rec);
        }

        if path_is_descendant(src, dst) {
            let err_msg: String = "cannot copy a directory, '" + src + "', into itself, '" + dst + "'";
            let err_rec: CpFileRecord = CpFileRecord { src: src, dst: dst, bytes: 0, action: "dir", status: "failed", error: err_msg };
            return summary_add_record(cur_sum, err_rec);
        }

        if !path_exists(fr, dst) {
            let mk: Result[Void, String] = ensure_dir_p(fw, dst);
            if mk.is_err() {
                let err_msg: String = "cannot create directory '" + dst + "'";
                let err_rec: CpFileRecord = CpFileRecord { src: src, dst: dst, bytes: 0, action: "dir", status: "failed", error: err_msg };
                return summary_add_record(cur_sum, err_rec);
            }
        }

        let dir_rec: CpFileRecord = CpFileRecord { src: src, dst: dst, bytes: 0, action: "dir", status: "success", error: "" };
        cur_sum = summary_add_record(cur_sum, dir_rec);

        let entries: List[String] = oo_fs_read_dir(fr, src);
        let n: Int = list_len(entries);
        let mut i: Int = 0;
        while i < n {
            let name: String = list_get(entries, i);
            let sub_src: String = path_join(src, name);
            let sub_dst: String = path_join(dst, name);
            cur_sum = copy_tree_recursive(fr, fw, sub_src, sub_dst, cfg, cur_sum);
            i = i + 1;
        }
        return cur_sum;
    }

    let file_rec: CpFileRecord = copy_file_stream(fr, fw, src, dst, cfg);
    return summary_add_record(cur_sum, file_rec);
}

pub fn execute_cp(
    fr: &FsReadCap,
    fw: &FsWriteCap,
    cfg: CpConfig
) -> CpSummary {
    let mut summary: CpSummary = empty_cp_summary();
    let n_sources: Int = list_len(cfg.sources);
    if n_sources == 0 {
        return summary;
    }

    let is_target_dir: Bool = if chars_len(cfg.target_dir) > 0 {
        true
    } else if path_exists(fr, cfg.dest) {
        oo_fs_is_dir(fr, cfg.dest)
    } else {
        str_ends_with(cfg.dest, "/")
    };

    let target_base: String = if chars_len(cfg.target_dir) > 0 {
        cfg.target_dir
    } else {
        cfg.dest
    };

    let mut i: Int = 0;
    while i < n_sources {
        let src: String = list_get(cfg.sources, i);
        let dst: String = if is_target_dir {
            path_join(target_base, path_basename(src))
        } else {
            target_base
        };
        summary = copy_tree_recursive(fr, fw, src, dst, cfg, summary);
        i = i + 1;
    }
    return summary;
}
